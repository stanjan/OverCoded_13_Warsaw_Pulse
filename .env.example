# Local OpenAI-compatible API exposed by npm run bridge:start.
CODEX_BRIDGE_URL=http://127.0.0.1:8780/v1
# Blank: available Antigravity > Codex (gpt-6.1-sol@low) > Claude CLI default.
# Explicit examples: codex-chatgpt, claude-cli/default, claude-cli/sonnet.
CODEX_BRIDGE_MODEL=
CODEX_BRIDGE_API_KEY=
# Optional absolute native Claude executable or JS entry point (not .cmd/.bat).
CLAUDE_CLI_PATH=
# Native Codex app-server executable or JavaScript entry point (blank uses PATH).
CODEX_APP_SERVER_PATH=
# Optional legacy /v1/run execution uses WSL on Windows.
CODEX_WSL_DISTRO=
CODEX_WSL_NODE=/usr/bin/node
DATA_API_KEY=
PORT=5173
# Address the dev server listens on (blank = localhost). Set to this machine's IP to reach it from other devices.
HOST=
# Optional local HTTPS for phone geolocation. Generate first: npm run cert:local -- <LAN-IP>
# HTTP remains available on PORT to download the public CA at /dev-ca.cer.
HTTPS_PORT=
TLS_CERT_FILE=.local/tls/server.pem
TLS_KEY_FILE=.local/tls/server.key
TLS_CA_FILE=.local/tls/ca.cer
# Google Maps (browser key restricted to your site + Maps JavaScript API). Leave empty to use OpenStreetMap.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
# Pedestrian routing: blank uses the public Valhalla demo for local prototypes.
# Production: configure your own trusted HTTPS Valhalla /route endpoint (loopback HTTP is supported).
WALK_ROUTING_URL=
